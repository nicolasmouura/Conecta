# Copie para .env.local e preencha. O .env.local não vai para o Git.
# Chave do Google Maps para o Android (Google Cloud → APIs e serviços →
# Credenciais), restrita ao pacote com.conecta.
GOOGLE_MAPS_API_KEY=

# Firebase (Console → Configurações do projeto → Seus apps → app da Web).
# Lidas pelo app no Expo Go (prefixo EXPO_PUBLIC_). Não são senhas: quem
# protege os dados é o firestore.rules.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
