{
  "name": "app-integrado",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "test": "node --disable-warning=ExperimentalWarning node_modules/jest/bin/jest.js",
    "pretest:regras": "node scripts/encerrarEmulador.js",
    "test:regras": "firebase emulators:exec --only firestore --project demo-conecta \"node --disable-warning=ExperimentalWarning node_modules/jest/bin/jest.js --config jest.regras.config.js\""
  },
  "dependencies": {
    "@expo-google-fonts/poppins": "^0.4.1",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~58.0.22",
    "expo-battery": "~58.0.3",
    "expo-camera": "~58.0.14",
    "expo-crypto": "~58.0.7",
    "expo-font": "~58.0.11",
    "expo-image-manipulator": "~58.0.16",
    "expo-image-picker": "~58.0.10",
    "expo-local-authentication": "~58.0.2",
    "expo-location": "~58.0.20",
    "expo-network": "~58.0.4",
    "expo-secure-store": "~58.0.2",
    "expo-sms": "~58.0.2",
    "expo-splash-screen": "~58.0.12",
    "expo-sqlite": "~58.0.15",
    "expo-status-bar": "~58.0.4",
    "firebase": "^12.19.0",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-maps": "1.29.11",
    "react-native-safe-area-context": "~5.10.1"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@expo/ngrok": "^4.1.3",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@testing-library/react-native": "^14.1.0",
    "firebase-tools": "^15.34.2",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.13"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "setupFiles": [
      "<rootDir>/jest.setup.js"
    ],
    "clearMocks": true,
    "testPathIgnorePatterns": [
      "/node_modules/",
      "<rootDir>/firestore.rules.test.js"
    ]
  }
