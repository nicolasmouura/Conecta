rules_version = '2';

// Regras de segurança do Conecta.
// Publicar em: Firebase Console > Firestore Database > Regras.
// Tudo o que não estiver liberado abaixo é NEGADO.

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------
    // FUNÇÕES AUXILIARES
    // ---------------------------------------------------

    function autenticado() {
      return request.auth != null;
    }

    function meuUid() {
      return request.auth.uid;
    }

    function meuEmail() {
      return request.auth.token.email.lower();
    }

    // E-mail confirmado pelo link do Firebase (o app pede no cadastro).
    // Sem isso, alguém poderia criar conta com o e-mail de outra pessoa
    // e receber os convites destinados a ela.
    function emailVerificado() {
      return request.auth.token.email_verified == true;
    }

    function caminhoUsuario(uid) {
      return /databases/$(database)/documents/usuarios/$(uid);
    }

    function caminhoGrupo(grupoId) {
      return /databases/$(database)/documents/grupos/$(grupoId);
    }

    function caminhoMembro(grupoId, uid) {
      return /databases/$(database)/documents/grupos/$(grupoId)/membros/$(uid);
    }

    // Convite destinado ao usuário atual para essa família.
    function caminhoMeuConvite(grupoId) {
      return /databases/$(database)/documents/convites/$(grupoId + '_' + meuEmail());
    }

    function ehMembro(grupoId) {
      return autenticado()
        && meuUid() in get(caminhoGrupo(grupoId)).data.membros;
    }

    // Membro depois que o lote de gravações for aplicado.
    function ehMembroDepois(grupoId) {
      return meuUid() in getAfter(caminhoGrupo(grupoId)).data.membros;
    }

    function semFamilia() {
      return !exists(caminhoUsuario(meuUid()))
        || get(caminhoUsuario(meuUid())).data.get('grupoId', null) == null;
    }

    function nomeValido(nome) {
      return nome is string && nome.size() > 0 && nome.size() <= 60;
    }

    function textoOpcional(dados, campo, maximo) {
      return !(campo in dados)
        || (dados[campo] is string && dados[campo].size() <= maximo);
    }

    // Dados pessoais editáveis pelo dono em "Meu Perfil".
    function dadosPessoaisValidos(dados) {
      return (!('nome' in dados) || nomeValido(dados.nome))
        && textoOpcional(dados, 'telefone', 20)
        && textoOpcional(dados, 'endereco', 400)
        && (!('enderecoDetalhado' in dados) || enderecoDetalhadoValido(dados.enderecoDetalhado))
        && textoOpcional(dados, 'atualizadoEm', 40)
        && fotoValida(dados);
    }

    // Foto de perfil: miniatura JPEG em base64 (data URI), até 100.000 caracteres.
    function fotoValida(dados) {
      return !('foto' in dados)
        || (dados.foto is string
            && dados.foto.size() <= 100000
            && dados.foto.matches('^data:image/jpeg;base64,[A-Za-z0-9+/=]+$'));
    }

    // CPF no formato 000.000.000-00.
    function cpfFormatado(valor) {
      return valor is string && valor.matches('^[0-9]{3}[.][0-9]{3}[.][0-9]{3}-[0-9]{2}$');
    }

    function caminhoDocumentos(uid) {
      return /databases/$(database)/documents/usuarios/$(uid)/privado/documentos;
    }

    // O CPF fica em usuarios/{uid}/privado/documentos (só o dono lê).
    // Contas antigas ainda têm o campo "documento" no perfil, que a
    // família lê: ele não muda, e só pode SAIR se, no mesmo lote, a
    // cópia privada tiver o mesmo valor. Nunca entra de novo.
    function documentoSoSaiParaAreaPrivada(userId) {
      let anterior = resource.data.get('documento', null);
      let novo = request.resource.data.get('documento', null);
      return novo == anterior
        || (novo == null
            && existsAfter(caminhoDocumentos(userId))
            && getAfter(caminhoDocumentos(userId)).data.cpf == anterior);
    }

    // O perfil pertence a uma família da qual o usuário atual é membro.
    function perfilDaMinhaFamilia(perfil) {
      let grupoId = perfil.get('grupoId', null);
      return grupoId is string && ehMembro(grupoId);
    }

    // O grupoId do perfil só muda de "vazio" para uma família da qual
    // o usuário realmente é membro, ou de volta para "vazio" quando
    // ele sai (deixa de estar em "membros" ou a família é apagada).
    function vinculoDeFamiliaValido(grupoAnterior) {
      let novoGrupo = request.resource.data.get('grupoId', null);
      return novoGrupo == grupoAnterior
        || (grupoAnterior == null
            && novoGrupo is string
            && ehMembroDepois(novoGrupo))
        || (grupoAnterior is string
            && novoGrupo == null
            && (!existsAfter(caminhoGrupo(grupoAnterior))
                || !(meuUid() in getAfter(caminhoGrupo(grupoAnterior)).data.membros)));
    }

    // Última localização conhecida (familiares/{uid}).
    // uid, grupoId e nome não vêm "de confiança" do app: são
    // conferidos com usuarios/{uid}, e o grupo com o array de membros.
    function localizacaoValida(userId) {
      let dados = request.resource.data;
      let perfil = get(caminhoUsuario(meuUid())).data;
      return autenticado()
        && meuUid() == userId
        && dados.keys().hasAll(['uid', 'grupoId', 'nome', 'latitude', 'longitude', 'atualizadoEm'])
        && dados.keys().hasOnly(['uid', 'grupoId', 'nome', 'latitude', 'longitude', 'precisao', 'atualizadoEm', 'online', 'rua', 'emCasa', 'distanciaCasa'])
        && dados.uid == meuUid()
        && dados.grupoId == perfil.get('grupoId', null)
        && ehMembro(dados.grupoId)
        && dados.nome == perfil.get('nome', null)
        && dados.latitude is number && dados.latitude >= -90 && dados.latitude <= 90
        && dados.longitude is number && dados.longitude >= -180 && dados.longitude <= 180
        && (!('precisao' in dados) || (dados.precisao is number && dados.precisao >= 0))
        && dados.atualizadoEm == request.time
        && (!('online' in dados) || dados.online is bool)
        && derivadosDaCasaValidos(dados);
    }

    // Etapa 11: derivados publicados pelo próprio usuário. A casa em si
    // (endereço/coordenadas) nunca entra aqui. A distância precisa estar
    // arredondada (100 m até 1 km; 500 m acima) para não expor a casa.
    function derivadosDaCasaValidos(dados) {
      return (!('rua' in dados) || (dados.rua is string && dados.rua.size() <= 120))
        && (!('emCasa' in dados) || dados.emCasa is bool)
        && (!('distanciaCasa' in dados) || (
          dados.distanciaCasa is int
          && dados.distanciaCasa >= 0
          && dados.distanciaCasa <= 40000000
          && ((dados.distanciaCasa < 1000 && dados.distanciaCasa % 100 == 0)
              || dados.distanciaCasa % 500 == 0)
        ));
    }

    // Meus lugares (usuarios/{uid}/lugares/{lugarId}): PRIVADOS.
    function textoObrigatorio(valor, limite) {
      return valor is string && valor.size() > 0 && valor.size() <= limite;
    }

    // Endereço em partes (mesmos limites de enderecos.js/CAMPOS_ENDERECO).
    function enderecoDetalhadoValido(e) {
      let campos = ['pais', 'estado', 'cidade', 'bairro', 'rua', 'numero', 'cep'];
      return e is map
        && e.keys().hasAll(campos)
        && e.keys().hasOnly(campos)
        && textoObrigatorio(e.pais, 40)
        && textoObrigatorio(e.estado, 40)
        && textoObrigatorio(e.cidade, 60)
        && textoObrigatorio(e.bairro, 60)
        && textoObrigatorio(e.rua, 100)
        && textoObrigatorio(e.numero, 15)
        && textoObrigatorio(e.cep, 10);
    }

    function lugarValido(userId, lugarId) {
      let dados = request.resource.data;
      let campos = ['tipo', 'nome', 'endereco', 'enderecoDetalhado', 'latitude', 'longitude', 'atualizadoEm'];
      return autenticado()
        && meuUid() == userId
        && lugarId.matches('^(casa|trabalho|escola|outro_[a-z0-9]{1,20})$')
        && dados.keys().hasAll(campos)
        && dados.keys().hasOnly(campos)
        && dados.tipo == (lugarId.matches('^outro_.*') ? 'outro' : lugarId)
        && dados.nome is string && dados.nome.size() > 0 && dados.nome.size() <= 40
        && textoObrigatorio(dados.endereco, 400)
        && enderecoDetalhadoValido(dados.enderecoDetalhado)
        && dados.latitude is number && dados.latitude >= -90 && dados.latitude <= 90
        && dados.longitude is number && dados.longitude >= -180 && dados.longitude <= 180
        && dados.atualizadoEm == request.time;
    }

    // Família atual do dono do histórico (lida de usuarios/{uid}).
    function grupoDoUsuario(uid) {
      return get(caminhoUsuario(uid)).data.get('grupoId', null);
    }

    // Ponto de histórico (historicoLocalizacoes/{uid}/pontos/{id}).
    // Mesmas garantias da localização atual: o ponto é do usuário
    // autenticado, da família do perfil, com coordenadas válidas
    // e horário do servidor.
    function pontoHistoricoValido(userId) {
      let dados = request.resource.data;
      let perfil = get(caminhoUsuario(meuUid())).data;
      return autenticado()
        && meuUid() == userId
        && dados.keys().hasAll(['uid', 'grupoId', 'latitude', 'longitude', 'registradoEm'])
        && dados.keys().hasOnly(['uid', 'grupoId', 'latitude', 'longitude', 'precisao', 'registradoEm'])
        && dados.uid == meuUid()
        && dados.grupoId == perfil.get('grupoId', null)
        && ehMembro(dados.grupoId)
        && dados.latitude is number && dados.latitude >= -90 && dados.latitude <= 90
        && dados.longitude is number && dados.longitude >= -180 && dados.longitude <= 180
        && (!('precisao' in dados) || (dados.precisao is number && dados.precisao >= 0))
        && dados.registradoEm == request.time;
    }

    // Novo alerta SOS: do próprio usuário, na família do perfil,
    // com o nome do perfil, horário do servidor e coordenadas
    // válidas (as duas juntas) ou ausentes.
    function sosNovoValido() {
      let dados = request.resource.data;
      let perfil = get(caminhoUsuario(meuUid())).data;
      return autenticado()
        && dados.keys().hasAll(['uid', 'grupoId', 'nome', 'criadoEm', 'status'])
        && dados.keys().hasOnly(['uid', 'grupoId', 'nome', 'latitude', 'longitude', 'criadoEm', 'status'])
        && dados.uid == meuUid()
        && dados.grupoId == perfil.get('grupoId', null)
        && ehMembro(dados.grupoId)
        && dados.nome == perfil.get('nome', null)
        && dados.status == 'ativo'
        && dados.criadoEm == request.time
        && (('latitude' in dados) == ('longitude' in dados))
        && (!('latitude' in dados) || (
          dados.latitude is number && dados.latitude >= -90 && dados.latitude <= 90
          && dados.longitude is number && dados.longitude >= -180 && dados.longitude <= 180
        ));
    }

    // Encerrar: só o autor, só de "ativo" para "encerrado",
    // mudando apenas status e encerradoEm (horário do servidor).
    function encerramentoSOSValido() {
      return autenticado()
        && resource.data.uid == meuUid()
        && resource.data.status == 'ativo'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'encerradoEm'])
        && request.resource.data.status == 'encerrado'
        && request.resource.data.encerradoEm == request.time;
    }

    // Mesma normalização do app (normalizarNome em salvarUsuario.js).
    function nomeNormalizado(nome) {
      return nome.lower().replace('[ \t]+', ' ').trim();
    }

    function caminhoDiretorio(chave) {
      return /databases/$(database)/documents/diretorioConvites/$(chave);
    }

    // O convidado (paraUid) é o uid do índice para ESSE nome completo
    // + e-mail, e ainda não é membro. O app não escolhe o uid.
    function convidadoValido(dados) {
      return dados.paraNome is string
        && dados.paraNome.size() > 0
        && dados.paraNome == nomeNormalizado(dados.paraNome)
        && dados.paraUid is string
        && dados.paraUid != meuUid()
        && dados.paraUid == get(caminhoDiretorio(dados.paraNome + '|' + dados.paraEmail)).data.uid
        && !(dados.paraUid in get(caminhoGrupo(dados.grupoId)).data.membros);
    }

    function conviteNovoValido(conviteId) {
      let dados = request.resource.data;
      return autenticado()
        && emailVerificado()
        && dados.keys().hasOnly(['grupoId', 'grupoNome', 'deUid', 'deNome', 'paraEmail', 'paraNome', 'paraUid', 'status', 'criadoEm'])
        && convidadoValido(dados)
        && dados.deUid == meuUid()
        && ehMembro(dados.grupoId)
        && dados.paraEmail is string
        && dados.paraEmail == dados.paraEmail.lower()
        && dados.paraEmail.matches('^[^@/ ]+@[^@/ ]+[.][^@/ ]+$')
        && dados.paraEmail != meuEmail()
        && conviteId == dados.grupoId + '_' + dados.paraEmail
        && dados.status == 'pendente'
        && textoObrigatorio(dados.criadoEm, 40)
        && dados.grupoNome == get(caminhoGrupo(dados.grupoId)).data.nome
        && dados.deNome == get(caminhoMembro(dados.grupoId, meuUid())).data.nome;
    }

    // Último membro saindo: os convites pendentes da família são
    // cancelados no mesmo lote (a família vai deixar de existir).
    function cancelamentoDeConviteValido() {
      return autenticado()
        && resource.data.status == 'pendente'
        && ehMembro(resource.data.grupoId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'respondidoEm'])
        && request.resource.data.status == 'cancelado'
        && textoObrigatorio(request.resource.data.respondidoEm, 40);
    }

    // Entrar: a única alteração permitida é o próprio usuário
    // se adicionar em "membros", e somente se existir um convite
    // PENDENTE para o e-mail dele que vira ACEITO no mesmo lote.
    // nome, administradorUid e demais campos não podem mudar.
    function entradaNaFamiliaValida(grupoId) {
      return autenticado()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['membros'])
        && !(meuUid() in resource.data.membros)
        && request.resource.data.membros.hasAll(resource.data.membros)
        && request.resource.data.membros.size() == resource.data.membros.size() + 1
        && meuUid() in request.resource.data.membros
        && semFamilia()
        && get(caminhoMeuConvite(grupoId)).data.status == 'pendente'
        && getAfter(caminhoMeuConvite(grupoId)).data.status == 'aceito'
        && getAfter(caminhoUsuario(meuUid())).data.get('grupoId', null) == grupoId
        && existsAfter(caminhoMembro(grupoId, meuUid()));
    }

    // Sair (com outros membros ficando): só o próprio uid sai de
    // "membros". Se quem sai é o administrador, o papel passa para
    // um dos que ficam; senão, o administrador não muda. O perfil
    // e o registro do membro mudam no mesmo lote.
    function saidaDaFamiliaValida(grupoId) {
      let novos = request.resource.data.membros;
      return autenticado()
        && meuUid() in resource.data.membros
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['membros', 'administradorUid'])
        && novos == resource.data.membros.removeAll([meuUid()])
        && novos.size() > 0
        && (resource.data.administradorUid == meuUid()
            ? request.resource.data.administradorUid in novos
            : request.resource.data.administradorUid == resource.data.administradorUid)
        && getAfter(caminhoUsuario(meuUid())).data.get('grupoId', null) == null
        && !existsAfter(caminhoMembro(grupoId, meuUid()));
    }

    function respostaDeConviteValida() {
      let dados = request.resource.data;
      return autenticado()
        && emailVerificado()
        && resource.data.status == 'pendente'
        && resource.data.paraEmail == meuEmail()
        && resource.data.paraUid == meuUid()
        && dados.diff(resource.data).affectedKeys().hasOnly(['status', 'paraUid', 'respondidoEm'])
        && dados.paraUid == meuUid()
        && textoObrigatorio(dados.respondidoEm, 40)
        && (
          dados.status == 'recusado'
          || (dados.status == 'aceito'
              && ehMembroDepois(resource.data.grupoId)
              && existsAfter(caminhoMembro(resource.data.grupoId, meuUid())))
        );
    }

    // ---------------------------------------------------
    // USUÁRIOS: o dono lê e edita; membros da mesma família
    // apenas leem o perfil. Conquistas são só do dono.
    // ---------------------------------------------------

    match /usuarios/{userId} {
      allow read: if autenticado()
        && (meuUid() == userId || perfilDaMinhaFamilia(resource.data));

      allow create: if autenticado()
        && meuUid() == userId
        && request.resource.data.keys().hasOnly(['nome', 'email', 'uid', 'criadoEm', 'grupoId', 'telefone', 'endereco', 'enderecoDetalhado', 'atualizadoEm', 'foto'])
        && request.resource.data.get('uid', userId) == userId
        && (!('email' in request.resource.data) || request.resource.data.email.lower() == meuEmail())
        && textoOpcional(request.resource.data, 'criadoEm', 40)
        && dadosPessoaisValidos(request.resource.data)
        && vinculoDeFamiliaValido(null);

      // uid, email e criadoEm não podem mudar; o CPF antigo (documento)
      // só sai para a área privada. grupoId só muda pelo fluxo de família/convite.
      allow update: if autenticado()
        && meuUid() == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nome', 'telefone', 'documento', 'endereco', 'enderecoDetalhado', 'atualizadoEm', 'grupoId', 'foto'])
        && dadosPessoaisValidos(request.resource.data)
        && documentoSoSaiParaAreaPrivada(userId)
        && vinculoDeFamiliaValido(resource.data.get('grupoId', null));

      // Excluir a conta: só o dono, e depois de sair da família.
      allow delete: if autenticado()
        && meuUid() == userId
        && resource.data.get('grupoId', null) == null;

      // Dados sensíveis (CPF): SÓ o dono lê; a família não.
      // O CPF é gravado uma única vez e nunca muda. Só é apagado junto
      // com o perfil (excluir a conta), para não dar para trocá-lo.
      // Conta antiga: tem que ser o mesmo CPF que estava no perfil.
      match /privado/{documentoId} {
        allow read: if autenticado() && meuUid() == userId;

        allow create: if autenticado()
          && meuUid() == userId
          && documentoId == 'documentos'
          && request.resource.data.keys().hasOnly(['cpf'])
          && cpfFormatado(request.resource.data.cpf)
          && (!exists(caminhoUsuario(userId))
              || get(caminhoUsuario(userId)).data.get('documento', request.resource.data.cpf) == request.resource.data.cpf);

        allow update: if false;

        allow delete: if autenticado()
          && meuUid() == userId
          && !existsAfter(caminhoUsuario(userId));
      }

      match /conquistas/{conquistaId} {
        allow read, write: if autenticado() && meuUid() == userId;
      }

      // Só o dono lê e altera os próprios lugares. A leitura do perfil
      // pela família (acima) NÃO se aplica a esta subcoleção.
      match /lugares/{lugarId} {
        allow read, delete: if autenticado() && meuUid() == userId;
        allow create, update: if lugarValido(userId, lugarId);
      }
    }

    // ---------------------------------------------------
    // FAMÍLIAS
    // ---------------------------------------------------

    match /grupos/{grupoId} {
      // Somente membros leem a família. Não há listagem geral.
      allow get: if autenticado() && meuUid() in resource.data.membros;
      allow list: if false;

      // Criar: o criador é o administrador e o único membro,
      // não pode já ter família e o perfil é vinculado no mesmo lote.
      allow create: if autenticado()
        && emailVerificado()
        && request.resource.data.keys().hasOnly(['nome', 'administradorUid', 'membros', 'criadoEm'])
        && nomeValido(request.resource.data.nome)
        && textoObrigatorio(request.resource.data.criadoEm, 40)
        && request.resource.data.administradorUid == meuUid()
        && request.resource.data.membros == [meuUid()]
        && semFamilia()
        && getAfter(caminhoUsuario(meuUid())).data.get('grupoId', null) == grupoId
        && existsAfter(caminhoMembro(grupoId, meuUid()));

      // Entrar por convite ou sair (funções entradaNaFamiliaValida
      // e saidaDaFamiliaValida, acima).
      allow update: if entradaNaFamiliaValida(grupoId) || saidaDaFamiliaValida(grupoId);

      // O último membro, ao sair, apaga a família.
      allow delete: if autenticado()
        && resource.data.membros == [meuUid()]
        && !existsAfter(caminhoMembro(grupoId, meuUid()))
        && getAfter(caminhoUsuario(meuUid())).data.get('grupoId', null) == null;

      match /membros/{membroUid} {
        allow read: if ehMembro(grupoId);

        // Cada usuário só cria o PRÓPRIO registro, e somente se
        // (após o lote) estiver no array "membros" da família.
        allow create: if autenticado()
          && membroUid == meuUid()
          && ehMembroDepois(grupoId)
          && request.resource.data.keys().hasOnly(['uid', 'nome', 'papel', 'status', 'entrouEm', 'conviteId'])
          && request.resource.data.uid == meuUid()
          && nomeValido(request.resource.data.nome)
          && textoObrigatorio(request.resource.data.entrouEm, 40)
          && textoOpcional(request.resource.data, 'conviteId', 400)
          && request.resource.data.status == 'ativo'
          && request.resource.data.papel == (
            getAfter(caminhoGrupo(grupoId)).data.administradorUid == meuUid()
              ? 'administrador'
              : 'membro'
          );

        // O próprio membro só pode sincronizar a cópia do nome
        // com usuarios/{uid}, na mesma gravação do perfil.
        // A outra mudança é o administrador que sai passar o papel
        // para quem ele indicou em administradorUid (mesmo lote).
        // status, uid e demais campos não mudam.
        allow update: if autenticado() && (
          (membroUid == meuUid()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nome'])
            && nomeValido(request.resource.data.nome)
            && request.resource.data.nome == getAfter(caminhoUsuario(meuUid())).data.nome)
          || (membroUid != meuUid()
            && get(caminhoGrupo(grupoId)).data.administradorUid == meuUid()
            && getAfter(caminhoGrupo(grupoId)).data.administradorUid == membroUid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['papel'])
            && request.resource.data.papel == 'administrador')
        );

        // Sair da família: o próprio registro sai junto com o uid
        // de "membros" (ou com a família inteira, se era o último).
        allow delete: if autenticado()
          && membroUid == meuUid()
          && (!existsAfter(caminhoGrupo(grupoId))
              || !(meuUid() in getAfter(caminhoGrupo(grupoId)).data.membros));
      }
    }

    // ---------------------------------------------------
    // CONVITES: visíveis só para quem convidou, quem foi
    // convidado e os membros da família.
    // ---------------------------------------------------

    match /convites/{conviteId} {
      // Convite inexistente: membros podem verificar (antes de convidar)
      // que ainda não há convite para aquele e-mail na própria família.
      allow read: if autenticado() && (
        (resource == null && ehMembro(conviteId.split('_')[0]))
        || resource.data.paraEmail == meuEmail()
        || resource.data.deUid == meuUid()
        || ehMembro(resource.data.grupoId)
      );

      allow create: if conviteNovoValido(conviteId);

      // Reenviar (recusado, cancelado ou de quem já saiu da família:
      // conviteNovoValido exige que a pessoa não seja membro), o
      // convidado responder, ou um membro cancelar (último a sair).
      allow update: if (resource.data.status in ['recusado', 'cancelado', 'aceito'] && conviteNovoValido(conviteId))
        || respostaDeConviteValida()
        || cancelamentoDeConviteValido();

      // Excluir a conta: quem convidou ou quem foi convidado apaga.
      allow delete: if autenticado()
        && (resource.data.deUid == meuUid()
            || resource.data.get('paraUid', null) == meuUid()
            || resource.data.paraEmail == meuEmail());
    }

    // ---------------------------------------------------
    // LOCALIZAÇÃO (usada pelo mapa): somente membros da família
    // ---------------------------------------------------

    match /familiares/{userId} {
      // Somente membros da família dona da localização.
      allow read: if ehMembro(resource.data.grupoId);

      allow create, update: if localizacaoValida(userId);

      allow delete: if autenticado() && meuUid() == userId;
    }

    // ---------------------------------------------------
    // HISTÓRICO DE LOCALIZAÇÕES: o dono lê tudo; a família
    // atual do dono lê só os pontos registrados NESSA família
    // (quem sai leva o passado junto; uma família nova não vê
    // por onde a pessoa andou antes). Só o dono cria e apaga
    // (excluir a conta); pontos nunca são alterados.
    // ---------------------------------------------------

    match /historicoLocalizacoes/{userId}/pontos/{pontoId} {
      allow read: if autenticado()
        && (meuUid() == userId
            || (resource.data.grupoId == grupoDoUsuario(userId)
                && ehMembro(resource.data.grupoId)));

      allow create: if pontoHistoricoValido(userId);

      allow update: if false;
      allow delete: if autenticado() && meuUid() == userId;
    }

    // ---------------------------------------------------
    // ALERTAS SOS: membros da família do alerta e o autor
    // leem; só o autor cria, encerra e apaga (excluir a conta).
    // ---------------------------------------------------

    match /alertasSOS/{alertaId} {
      allow read: if ehMembro(resource.data.grupoId)
        || (autenticado() && resource.data.uid == meuUid());

      allow create: if sosNovoValido();

      allow update: if encerramentoSOSValido();

      allow delete: if autenticado() && resource.data.uid == meuUid();
    }

    // ---------------------------------------------------
    // ÍNDICE PARA CONVITES: {nome normalizado|e-mail} → { uid }.
    // Leitura só por chave exata (quem sabe nome E e-mail); listar
    // é proibido. Cada usuário só cria/apaga a própria entrada,
    // com o nome do próprio perfil e o e-mail do próprio login.
    // ---------------------------------------------------

    match /diretorioConvites/{chave} {
      allow get: if autenticado();
      allow list: if false;

      allow create: if autenticado()
        && emailVerificado()
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == meuUid()
        && chave == nomeNormalizado(getAfter(caminhoUsuario(meuUid())).data.nome) + '|' + meuEmail();

      allow update: if false;
      allow delete: if autenticado() && resource.data.uid == meuUid();
    }

    // A coleção antiga "solicitacoes" (entrada por código)
    // não é mais usada e fica bloqueada pela regra padrão.
  }
}
