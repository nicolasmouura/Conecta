{
  "expo": {
    "name": "Conecta",
    "slug": "Conecta",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "br.com.conecta.app",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1B71F9"
      },
      "permissions": [
        "android.permission.CAMERA"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "package": "br.com.conecta.app"
    },
    "plugins": [
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "O Conecta usa o Face ID para confirmar que é você ao abrir o app e ao encerrar um SOS."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "O Conecta usa sua localização, enquanto o app está aberto, para mostrar sua posição no mapa, compartilhá-la com sua família e enviá-la junto com um SOS.",
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false,
          "locationFullAccuracyPermission": false,
          "motionUsagePermission": false,
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "O Conecta usa a câmera para você tirar a sua foto de perfil.",
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "O Conecta acessa suas fotos para você escolher a sua foto de perfil.",
          "cameraPermission": "O Conecta usa a câmera para você tirar a sua foto de perfil.",
          "microphonePermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F4F8FF"
        }
      ],
      "expo-font",
      "expo-secure-store",
      "expo-sqlite"
    ]
  }
}
