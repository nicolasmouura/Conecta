{
  "expo": {
    "name": "Conecta",
    "slug": "Conecta",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0754D9"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Este app precisa acessar a câmera para tirar fotos."
      },
      "bundleIdentifier": "com.conecta"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "android.permission.CAMERA"
      ],
      "package": "com.conecta"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Permitir $(PRODUCT_NAME) a usar o Face ID."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "O Conecta precisa da sua localização para mostrar sua posição no mapa e compartilhá-la com sua família."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Permita que o aplicativo utilize a câmera."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Permita que o aplicativo acesse suas fotos."
        }
      ],
      "expo-font",
      "expo-secure-store"
    ]
  }
}